# Copiar como .env (no se sube al repositorio) y completar.

# Base de datos. Local por defecto; en la nube usar la cadena de MongoDB Atlas.
MONGODB_URI=mongodb://127.0.0.1:27017/legion

# Secreto para firmar las sesiones. En producción es obligatorio y debe ser
# largo y aleatorio, por ejemplo el resultado de:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_DURACION=8h

PORT=3100

# Orígenes permitidos (frontend), separados por coma. Vacío = todos.
CORS_ORIGENES=http://localhost:4300

# Solo para "npm run seed" (primer administrador).
ADMIN_EMAIL=
ADMIN_NOMBRE=Administrador
ADMIN_CLAVE=
